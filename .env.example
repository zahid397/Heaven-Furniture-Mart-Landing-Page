# ---------------------------------------------------------------------------
# Heaven Furniture Mart - environment variables
# Copy this file to .env.local for local development, and add the same values
# to the Vercel project settings for production.
# Both variables are NEXT_PUBLIC_* because they are used in the rendered markup.
# ---------------------------------------------------------------------------

# WhatsApp number that every CTA on the page opens a chat with.
# Any format works - non-digits are stripped before the wa.me link is built.
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801960481983

# Canonical site URL. Used for metadataBase, OpenGraph/Twitter absolute image
# URLs and the JSON-LD @id. Must include the scheme and no trailing slash.
NEXT_PUBLIC_SITE_URL=https://heavenfurnituremart.com
